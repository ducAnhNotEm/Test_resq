{
  "name": "resq-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ResQ backend: REST API + WebSocket telemetry relay + Admin web",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "online": "node --disable-warning=ExperimentalWarning scripts/online.ts",
    "rotate-passwords": "node --disable-warning=ExperimentalWarning scripts/rotate-passwords.ts",
    "set-password": "node --disable-warning=ExperimentalWarning scripts/set-password.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "~6.0.3",
    "cloudflared": "^0.7.3",
    "qrcode-terminal": "^0.12.0"
  }
}
