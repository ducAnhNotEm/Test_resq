# Key Goong — server nội bộ (thư mục server/) cũng đọc file này, không cần chép sang chỗ khác.
# Key REST (Directions / Geocoding): CHỈ server dùng, app không gọi Goong REST trực tiếp.
EXPO_PUBLIC_GOONG_API_KEY=
# Key Map Tiles: app + trang admin dùng để hiển thị bản đồ.
EXPO_PUBLIC_GOONG_MAP_KEY=

# (Tùy chọn) Địa chỉ server nội bộ. Để trống: app tự dò theo IP của laptop đang chạy Expo, cổng 8787.
# Chỉ cần đặt khi server chạy trên một laptop KHÁC laptop chạy Expo.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
