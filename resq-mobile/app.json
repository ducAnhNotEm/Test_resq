{
  "expo": {
    "name": "ResQ",
    "slug": "resq-mobile",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.resq.mobile"
    },
    "android": {
      "package": "vn.resq.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ResQ dùng vị trí của bạn để hiển thị và cập nhật tuyến cứu hộ trực tiếp."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1084ff9c-d0aa-492a-90b0-d9ef5738fcfa"
      }
    },
    "scheme": "resq"
  }
}
