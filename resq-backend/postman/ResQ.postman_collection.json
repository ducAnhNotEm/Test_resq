{
  "info": {
    "_postman_id": "455f9697-824f-4e4a-83f8-189474c47387",
    "name": "ResQ API - Giai đoạn 1 & 2",
    "description": "Chạy lần lượt từ Health đến Logout. Request OTP trả devOtp chỉ ở NODE_ENV khác production; production cần tích hợp SMS provider.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API is healthy', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Auth", "item": [
      { "name": "Request OTP (dev only)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/request-otp" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OTP requested', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.devOtp, 'devOtp is returned only outside production').to.be.a('string');", "pm.environment.set('otp', body.devOtp);"] } }] },
      { "name": "Verify OTP and save token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"code\": \"{{otp}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/verify-otp" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OTP verified', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.accessToken).to.be.a('string');", "pm.environment.set('accessToken', body.accessToken);"] } }] },
    ] },
    { "name": "Profile", "item": [
      { "name": "GET me", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/users/me" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Profile loaded', () => pm.response.to.have.status(200));"] } }] },
      { "name": "PATCH me", "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nguyễn Văn ResQ\",\n  \"email\": \"resq.postman@example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/users/me" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Profile updated', () => pm.response.to.have.status(200));"] } }] }
    ] },
    { "name": "Vehicles", "item": [
      { "name": "GET vehicles", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/vehicles" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Vehicles loaded', () => pm.response.to.have.status(200));"] } }] },
      { "name": "POST vehicle", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Toyota Camry 2023\",\n  \"plate\": \"30H-123.45\",\n  \"vin\": \"TESTVIN12345\",\n  \"color\": \"Trắng\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/vehicles" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Vehicle created', () => pm.response.to.have.status(201));", "pm.environment.set('vehicleId', pm.response.json().data.id);"] } }] },
      { "name": "PATCH vehicle", "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Toyota Camry\",\n  \"isDefault\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/vehicles/{{vehicleId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Vehicle updated', () => pm.response.to.have.status(200));"] } }] },
      { "name": "DELETE vehicle", "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/vehicles/{{vehicleId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Vehicle deleted', () => pm.response.to.have.status(204));"] } }] }
    ] },
    { "name": "Emergency contacts", "item": [
      { "name": "GET contacts", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/emergency-contacts" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Contacts loaded', () => pm.response.to.have.status(200));"] } }] },
      { "name": "POST contact", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nguyễn Thị Mai\",\n  \"phone\": \"0912345000\",\n  \"relation\": \"Vợ\",\n  \"shareLocation\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/emergency-contacts" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Contact created', () => pm.response.to.have.status(201));", "pm.environment.set('contactId', pm.response.json().data.id);"] } }] },
      { "name": "PATCH contact", "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"shareLocation\": false\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/emergency-contacts/{{contactId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Contact updated', () => pm.response.to.have.status(200));"] } }] },
      { "name": "DELETE contact", "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/emergency-contacts/{{contactId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Contact deleted', () => pm.response.to.have.status(204));"] } }] }
    ] },
    { "name": "Saved places", "item": [
      { "name": "GET places", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/saved-places" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Places loaded', () => pm.response.to.have.status(200));"] } }] },
      { "name": "POST place", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"home\",\n  \"title\": \"Nhà riêng\",\n  \"address\": \"12 Cầu Giấy, Hà Nội\",\n  \"latitude\": 21.03,\n  \"longitude\": 105.80\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/saved-places" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Place created', () => pm.response.to.have.status(201));", "pm.environment.set('placeId', pm.response.json().data.id);"] } }] },
      { "name": "PATCH place", "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Nhà của tôi\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/saved-places/{{placeId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Place updated', () => pm.response.to.have.status(200));"] } }] },
      { "name": "DELETE place", "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/saved-places/{{placeId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Place deleted', () => pm.response.to.have.status(204));"] } }] }
    ] },
    { "name": "Logout (run last; invalidates current token)", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/auth/logout" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Logout succeeded', () => pm.response.to.have.status(200));"] } }] }
  ]
}
